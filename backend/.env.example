PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Neon Postgres: DATABASE_URL usa el host -pooler; DIRECT_URL el host directo
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Firma de los JWT de sesión (genera uno con: openssl rand -base64 48)
JWT_SECRET=

# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

BOOSTER_PACK_PRICE_USD=4.99
